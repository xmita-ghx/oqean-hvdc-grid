# 1. Environment Variables & API Secrets (CRITICAL: NEVER COMMIT)
.env
*.env
!.env.example

# 2. Python Bytecode & Cache Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints/
*/.ipynb_checkpoints/
.virtual_documents/

# 5. IDE & Code Editor Configurations
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# 6. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db