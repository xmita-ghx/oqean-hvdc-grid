# =====================================================================
# oqean-hvdc-grid Environment Credentials
# =====================================================================
# Copy this file to a new file named '.env' in the root directory:
#   cp .env.example .env
#
# Replace the placeholder values below with your actual Quantum Rings credentials.
# Get your API key at: https://portal.quantumrings.com/
# =====================================================================

QUANTUMRINGS_TOKEN=your_quantum_rings_api_token_here
QUANTUMRINGS_NAME=your_quantum_rings_account_name_here